# Ignore everything in the deploy folder
/deploy/*

# Allow docker-compose.yml and .env to be tracked
!/deploy/docker-compose.yml
!/deploy/.env

# Ignore .NET-specific files
bin/
obj/
.vs/
.vscode/
.idea/

# Ignore user-specific files
*.user
*.userosscache
*.suo
*.userprefs
*.log

# Ignore build output files
*.dll
*.exe
*.pdb
*.apk
*.ipa

# Ignore ASP.NET Core specific files
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json

# Ignore temporary files generated by Visual Studio and .NET
.vs2019/
.vs2017/
.vs2015/

# Ignore NuGet files
packages/
*.nupkg
*.snupkg

# Ignore test results
TestResults/
*.trx

# Ignore coverage files
/coverage/

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore other temporary files
*.bak
*.tmp
*.swp
